VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key
# E-mail de suporte ao cliente. Enquanto estiver vazio, os links de contacto
# ficam ocultos na landing, na página de planos e no perfil (nada quebra).
VITE_SUPPORT_EMAIL=suporte@exemplo.com
VITE_DEV_ACTIVE_PLAN_EMAILS=
# Site Key do Cloudflare Turnstile (chave pública — a Secret Key NUNCA entra aqui,
# ela só é configurada no painel do Supabase em Authentication > Attack Protection).
VITE_TURNSTILE_SITE_KEY=

# Supabase Edge Function secrets
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_QUARTERLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Páginas públicas: sem este segredo, recusam formulários em vez de os aceitar sem
# proteção. É a mesma Secret Key do Turnstile, agora também como segredo da função.
TURNSTILE_SECRET_KEY=

# Cobrança dos alunos, à parte da subscrição do PTMANAGER. Desligada por omissão.
# Com a chave sk_live_ só funciona com STRIPE_CONNECT_LIVE=true, a autorizar à parte.
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_LIVE=false

# Notificações no telemóvel. Sem estas chaves a função responde «configuração em falta».
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=
CRON_SECRET=
